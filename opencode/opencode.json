{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "ask",
    "skill": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "question": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder-next:latest": {
          "name": "qwen3-coder-next:latest",
          "tools": true
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b",
          "tools": true
        },
        "deepseek-coder-v2:16b": {
          "name": "deepseek-coder-v2:16b",
          "tools": true
        },
        "qwen3.5:35b": {
          "name": "qwen3.5:35b",
          "tools": true
        },
        "qwen2.5:14b-instruct-q4_K_M": {
          "name": "qwen2.5:14b-instruct-q4_K_M",
          "tools": true
        }
      }
    }
  }
}
